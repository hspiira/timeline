# Timeline — one environment for the whole stack.
#
# A deployment is a single process: the API serves the web bundle from the same
# origin. Keeping one file in development means development and production cannot
# drift apart. Copy this to .env and fill it in.
#
# The API reads every value here. Vite reads the same file but only ever exposes
# VITE_-prefixed values to the browser bundle, so nothing below that line reaches
# a client.

# ── Required ─────────────────────────────────────────────────────────────────
# Minimum 32 characters:  openssl rand -hex 32
SECRET_KEY=
# Minimum 16 characters:  openssl rand -hex 16
ENCRYPTION_SALT=
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/timeline

# ── Tenant provisioning ──────────────────────────────────────────────────────
# Required by POST /tenants. Also set VITE_CREATE_TENANT_SECRET to the same value
# for the registration screen to work in development.
CREATE_TENANT_SECRET=
# Base for the one-time set-password links returned by tenant creation and invites.
SET_PASSWORD_BASE_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# REDIS_ENABLED=false
# STORAGE_BACKEND=local
# STORAGE_ROOT=./storage
# Unused when the API serves the bundle; only needed if the two run on separate
# origins during development.
# ALLOWED_ORIGINS=http://localhost:3000

# ── Client ───────────────────────────────────────────────────────────────────
# Everything below is compiled into the browser bundle. Never put a secret here.

# Development only, and never in production: this value ships in the bundle.
VITE_CREATE_TENANT_SECRET=
# Normally unset. The client calls /api relatively; vite proxies it in development
# and the API serves it in production. Set only to target an API elsewhere.
# VITE_API_URL=https://api.example.com
# Where the dev proxy forwards /api. Defaults to http://localhost:8000.
# VITE_PROXY_TARGET=http://localhost:8000
