# Repository-wide. Anything specific to one package lives in that package's
# .gitignore, which should stay short.

# Secrets. Only .env.example is tracked, and there is one .env at this root
# shared by both applications.
.env
.env.*
!.env.example
.env*.local
secrets/
serviceAccountKey*.json
*-firebase-adminsdk-*.json
**/credentials.json
**/gcp-key*.json
**/google-credentials*.json
**/*-service-account-*.json

# Operating system
.DS_Store

# Editors. settings.json is shared on purpose: it marks the generated route tree
# read-only and picks the formatter. Everything else under .vscode is personal.
.vscode/*
!.vscode/settings.json
.idea/

# Python
__pycache__/
*.py[oc]
*.egg-info
.venv
build/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*

# JavaScript
node_modules/
dist/
dist-ssr/
.tanstack/

# Application data written at runtime
storage/

# graft's local graph cache — regenerable, run `graft build`.
/graft/
