# API (required for dev against a real backend)
# Normally leave unset. The client calls /api relatively; vite proxies it to
# VITE_PROXY_TARGET in development and the API serves the bundle in production.
# Set this only to point a local build at an API somewhere else.
# VITE_API_URL=https://api.example.com

# Where the dev proxy forwards /api. Defaults to http://localhost:8000.
# VITE_PROXY_TARGET=http://localhost:8000

# Optional: tenant creation (dev only; do not set in production)
# VITE_CREATE_TENANT_SECRET=your-secret

# E2E tests (Playwright critical path)
# E2E_TENANT_CODE=your-tenant
# E2E_LOGIN_EMAIL=user@example.com
# E2E_LOGIN_PASSWORD=secret

# Playwright base URL when not using webServer
# PLAYWRIGHT_BASE_URL=http://localhost:3000
