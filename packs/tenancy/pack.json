    {
      "tenant_code": "tenancy-demo",
      "name": "On rent paid -> record receipt",
      "description": "When a rent payment is recorded, prompt/append a receipt reference linkage (demonstration of a side-effect).",
      "trigger_event_type": "rent_paid",
      "is_active": true,
      "trigger_conditions": null,
      "actions": [
        {
          "type": "create_event",
          "params": {
            "event_type": "rent_paid",
            "schema_version": 1,
            "payload": {
              "for_month": "",
              "amount": 0,
              "currency": "UGX",
              "method": "mobile_money"
            }
          }
        }
      ],
      "max_executions_per_day": null,
      "execution_order": 0
    }
  ],

